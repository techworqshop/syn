          "query": "SELECT COUNT(*) AS total, COUNT(CASE WHEN $1 = 1 AND round_1_response IS NOT NULL AND length(round_1_response) > 50 THEN 1 WHEN $1 = 2 AND round_2_response IS NOT NULL AND length(round_2_response) > 50 THEN 1 WHEN $1 = 3 AND round_3_response IS NOT NULL AND length(round_3_response) > 50 THEN 1 END) AS done FROM \"data_table_user_oAfVlk69fSh57ABR\" WHERE session_id = $2",
          "options": {
            "queryReplacement": "={{ $('Execute Workflow Trigger').item.json.round_number }},{{ $('Execute Workflow Trigger').item.json.session_id }}"
