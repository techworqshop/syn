        "parameters": {
          "jsCode": "var statusRow=$('Check Persona Status').first().json;var trig=$('Execute Workflow Trigger').first().json;var iteration=$runIndex+1;var done=Number(statusRow.done||0);var total=Number(statusRow.total||0);var maxIter=24;var shouldStatus=iteration===4&&done<total;var timedOut=iteration>=maxIter;return [{json:{iteration:iteration,retries_done:0,should_retry:false,status_posted:shouldStatus,should_status:shouldStatus,timed_out:timedOut,done:done,total:total,session_id:trig.session_id,round_number:trig.round_number,problem_brief:trig.problem_brief,locale:trig.locale||'de'}}];"
