      {
        "id": "rp-agent",
        "name": "Run Persona Agent",
        "type": "@n8n/n8n-nodes-langchain.agent",
        "typeVersion": 3.1,
        "position": [
          976,
          176
        ],
        "parameters": {
          "promptType": "define",
          "text": "=Beziehe Stellung zum Problem-Brief in Runde {{ $json.round_number }} aus deiner Persona-Perspektive. Sei substanziell und ausfuehrlich. Schau dir die angehaengten Bilder direkt an oder nutze das Ask Vision Tool fuer Detail-Fragen.",
          "hasOutputParser": false,
          "needsFallback": false,
          "options": {
            "maxIterations": 25,
            "passthroughBinaryImages": true,
            "systemMessage": "=Du bist {{ $json.persona_id }} mit folgendem Profil:\n\n{{ $json.persona_profile }}\n\nPROBLEM BRIEF:\n{{ $json.problem_brief }}\n\n{{ $json.fileForensic ? 'BILD-FORENSIK (Vorab-Analyse vom Vision-Spezialist Gemini 3.1 Pro - praezise Beobachtungen):\\n\\n' + $json.fileForensic + '\\n\\nDie Original-Bilder sind ebenfalls angehaengt. Du kannst sie selbst anschauen oder das Ask Vision Tool aufrufen, wenn du gezielte Detail-Fragen hast (z.B. exakte Logo-Form, Klein-Text, Farbnuancen). Bei Diskrepanz zwischen deiner Wahrnehmung und der Forensik vertraue der Forensik.\\n' : '' }}\n{{ $json.previous_synthesis ? 'VORHERIGE SYNTHESE:\\n' + $json.previous_synthesis : '' }}\nHALTUNG: {{ ($json.rigidity ?? 5) <= 3 ? 'Du bist offen. Update deine Position bei guten Argumenten.' : ($json.rigidity ?? 5) <= 6 ? 'Ausgewogen. Update bei wirklich starken Argumenten.' : 'Du bist standhaft. Bleib bei deiner Position.' }}\n{{ $json.unresolved_tension ? 'UNRESOLVED TENSION:\\n' + $json.unresolved_tension : '' }}\n\nFORMATTING: Kein Markdown. Plain text. Zeilenumbrueche fuer Struktur. Emojis erlaubt. Keine Wortbegrenzung.\n\nWICHTIG - OUTPUT-FORMAT:\n- Sprich DIREKT als die Persona. Keine Meta-Kommentare ueber Tool-Aufrufe, keine \"Jetzt schreibe ich...\", keine Selbstreflexion vor der Antwort.\n- Wenn du Ask Vision benutzt, integriere die Erkenntnisse in deine Antwort, ohne den Vorgang zu erwaehnen.\n- Keine Pre-Text-Zeilen, keine \"---\" Separatoren am Anfang. Die erste Zeile MUSS die erste Zeile deiner inhaltlichen Antwort sein."
          }
        },
        "retryOnFail": true,
        "maxTries": 5,
        "waitBetweenTries": 3000
      }
