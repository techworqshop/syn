      {
        "parameters": {
          "jsCode": "var t=$('Execute Workflow Trigger').first().json;var d=$input.all();var rows=$('Get Session Files').all();var mb={};var ks=[];var fc=0;for(var i=0;i<d.length;i++){if(d[i].binary){var bk=Object.keys(d[i].binary);for(var k=0;k<bk.length;k++){var nk='file_'+fc;mb[nk]=d[i].binary[bk[k]];ks.push(nk);fc++;}}}var fp=[];for(var r=0;r<rows.length;r++){var j=rows[r].json||{};if(j.extracted_text){fp.push('=== Datei '+(r+1)+': '+(j.file_name||'?')+' ===\\n'+j.extracted_text);}}var fx=fp.join('\\n\\n---\\n\\n');var out=Object.assign({},t,{fileCount:fc,binaryKeys:ks.join(','),fileForensic:fx});return [{json:out,binary:fc>0?mb:undefined}];"
        },
        "id": "1489e8a4-3988-4b92-ab05-85effff79c11",
        "name": "Merge Files",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
