        ]
      },
      {
        "parameters": {
          "modelId": {
            "__rl": true,
            "value": "claude-sonnet-4-6",
            "mode": "id",
            "cachedResultName": "Claude Sonnet 4.6"
          },
          "messages": {
            "values": [
              {
                "content": "=Du bist {{ $('Execute Workflow Trigger').item.json.persona_id }} mit folgendem Profil:\n\n{{ $('Execute Workflow Trigger').item.json.persona_profile }}\n\nPROBLEM BRIEF:\n{{ $('Execute Workflow Trigger').item.json.problem_brief }}\n\n{{ $json.previous_synthesis ? 'VORHERIGE SYNTHESE:\\n' + $json.previous_synthesis : '' }}\nHALTUNG: {{ ($json.rigidity ?? 5) <= 3 ? 'Du bist offen. Aktualisiere deine Position aktiv basierend auf neuen Infos.' : ($json.rigidity ?? 5) <= 6 ? 'Ausgewogen. Update bei wirklich starken neuen Argumenten.' : 'Du bist standhaft. Bleib bei deiner Position, selbst bei guten Gegenargumenten.' }}\n{{ $json.unresolved_tension ? 'UNRESOLVED TENSION:\\n' + $json.unresolved_tension : '' }}\n\nDies ist Runde {{ $('Execute Workflow Trigger').item.json.round_number }}.\n\nFORMATTING: Kein Markdown. Nur plain text. Zeilenumbrueche fuer Struktur. Emojis erlaubt.\n\nAnalysiere das Problem aus deiner spezifischen Perspektive. Sei direkt und substanziell. Schreib so ausfuehrlich wie noetig - keine Wortbegrenzung, aber kein Geschwafel."
              }
            ]
          },
          "options": {
            "maxTokens": 20000,
            "temperature": 0.7
          }
        },
