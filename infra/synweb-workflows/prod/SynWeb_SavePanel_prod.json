        "parameters": {
          "jsCode": "const trig=$('Execute Workflow Trigger').first().json;\nlet arr;\ntry{arr=typeof trig.personas_json==='string'?JSON.parse(trig.personas_json):(trig.personas_json||[]);}catch(e){throw new Error('Invalid personas_json: '+e.message);}\nif(!Array.isArray(arr))throw new Error('personas_json must be array');\nreturn arr.map(p=>({json:{session_id:trig.session_id,persona_id:String(p.persona_id||''),name:String(p.name||''),type:String(p.type||''),core_perspective:String(p.core_perspective||''),profile:String(p.profile||''),slack_slot:Number(p.slack_slot||0),rigidity:Number(p.rigidity!=null?p.rigidity:5)}}));"
        }
      },
