        }
      },
      {
        "id": "build-body",
        "name": "Build Gemini Body",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          720,
          0
        ],
        "parameters": {
          "jsCode": "var question=$('Execute Workflow Trigger').first().json.question||'Beschreibe das Bild detailliert.';var items=$input.all();var parts=[{text:'Du bist Vision-Forensik. Beantworte die folgende Frage praezise auf Basis der angehaengten Bilder/Dokumente. Sei konkret und visuell, nicht abstrakt. Antwort auf Deutsch, plain text.\\n\\nFRAGE: '+question}];for(var i=0;i<items.length;i++){if(items[i].binary){var bk=Object.keys(items[i].binary);for(var k=0;k<bk.length;k++){var b=items[i].binary[bk[k]];var buf=await this.helpers.getBinaryDataBuffer(i,bk[k]);parts.push({inline_data:{mime_type:b.mimeType||'application/octet-stream',data:buf.toString('base64')}});}}}return [{json:{contents:[{parts:parts}],generationConfig:{temperature:0.2,maxOutputTokens:32768,thinkingConfig:{thinkingBudget:-1}}}}];"
        }
      },
      {
        "id": "gemini",
        "name": "Gemini Vision",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          960,
          0
        ],
        "parameters": {
          "method": "POST",
          "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "googlePalmApi",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify($json) }}",
          "options": {
            "timeout": 60000
          }
        },
        "credentials": {
          "googlePalmApi": {
            "id": "RsBy4nIm3pzcJC2k",
            "name": "Google Gemini(PaLM) Api account"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 3000
      },
      {
        "id": "extract",
        "name": "Extract Answer",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          1200,
          0
        ],
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "1",
                "name": "answer",
                "value": "={{ $json.candidates && $json.candidates[0] && $json.candidates[0].content && $json.candidates[0].content.parts ? $json.candidates[0].content.parts.filter(p => p.text).map(p => p.text).join('\\n') : 'Keine Antwort' }}",
                "type": "string"
              }
            ]
          },
          "options": {}
        }
      }
