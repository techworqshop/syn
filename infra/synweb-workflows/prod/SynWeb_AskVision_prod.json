          "limit": 10
        },
        "alwaysOutputData": true
      },
      {
        "id": "download",
        "name": "Download File",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          480,
          0
        ],
        "parameters": {
          "url": "={{ $json.file_url }}",
