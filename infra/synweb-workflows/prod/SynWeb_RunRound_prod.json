      {
        "id": "decide-action",
        "name": "Decide Retry/Wait",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1920,
          120
        ],
        "parameters": {
          "jsCode": "var statusRow=$('Check Persona Status').first().json;var state=$('Init Polling State').first().json;var iteration=(state.iteration||0)+1;var retriesDone=state.retries_done||0;var statusPosted=state.status_posted||false;var done=Number(statusRow.done||0);var total=Number(statusRow.total||0);var trig=$('Execute Workflow Trigger').first().json;var maxIter=40;var retryAt=[8,16,24];var statusAt=4;var shouldRetry=retryAt.indexOf(iteration)!==-1&&retriesDone<2&&done<total;var shouldStatus=iteration===statusAt&&!statusPosted&&done<total;var timedOut=iteration>=maxIter;return [{json:{iteration:iteration,retries_done:shouldRetry?retriesDone+1:retriesDone,status_posted:shouldStatus?true:statusPosted,should_retry:shouldRetry,should_status:shouldStatus,timed_out:timedOut,done:done,total:total,session_id:trig.session_id,round_number:trig.round_number,problem_brief:trig.problem_brief}}];"
        }
