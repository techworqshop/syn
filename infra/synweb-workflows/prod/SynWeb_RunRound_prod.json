      {
        "id": "build-payloads",
        "name": "Build Payloads",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          480,
          0
        ],
        "parameters": {
          "jsCode": "var trig=$('Execute Workflow Trigger').first().json;\nvar rows=$('Get Personas').all();\nvar syn=$('Get Syntheses').all();\nsyn.sort(function(a,b){return (a.json.round_number||0)-(b.json.round_number||0);});\nvar rn=trig.round_number;\nvar sh=syn.filter(function(s){return s.json.round_number&&s.json.round_number<rn&&s.json.synthesis_text;}).map(function(s){return 'RUNDE '+s.json.round_number+' (Synthese):\\n'+s.json.synthesis_text;}).join('\\n\\n---\\n\\n');\nvar out=[];\nfor(var i=0;i<rows.length;i++){\n  var p=rows[i].json;\n  var own='';\n  for(var r=1;r<rn;r++){\n    var resp=p['round_'+r+'_response'];\n    if(resp){own+='RUNDE '+r+' (deine Antwort):\\n'+resp+'\\n\\n';}\n  }\n  own=own.trim();\n  out.push({json:{session_id:trig.session_id,round_number:rn,problem_brief:trig.problem_brief,persona_id:p.persona_id||'',persona_profile:p.profile||'',rigidity:typeof p.rigidity==='number'?p.rigidity:5,slack_slot:p.slack_slot,own_history:own,synthesis_history:sh},pairedItem:{item:0}});\n}\nreturn out;\n"
        }
      },
