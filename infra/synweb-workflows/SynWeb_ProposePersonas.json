      {
        "id": "op-router",
        "name": "Op Router",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          240,
          0
        ],
        "parameters": {
          "jsCode": "const body = $input.first().json.body || {};\nconst sessionId = String(body.sessionId || '').trim();\nconst op = String(body.op || 'set').toLowerCase();\nconst personaId = body.personaId ? String(body.personaId).toLowerCase() : null;\nconst content = String(body.content || '');\nif (!sessionId) throw new Error('sessionId missing');\nconst validOps = ['set', 'add', 'update', 'remove'];\nif (!validOps.includes(op)) throw new Error('invalid op: ' + op);\nif ((op === 'update' || op === 'remove') && !personaId) {\n  throw new Error('personaId required for op=' + op);\n}\nreturn [{ json: { sessionId, op, personaId, content,\n  isRemove: op === 'remove',\n  isSet: op === 'set',\n  needsParse: op !== 'remove'\n}}];\n"
        }
      },
