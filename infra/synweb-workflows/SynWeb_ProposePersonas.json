      {
        "id": "ba8d8f15-b85d-45b7-b7f9-0835f4bb52c5",
        "name": "Resolve Personas",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          820,
          0
        ],
        "parameters": {
          "jsCode": "// Deterministic: prefer Syn-provided personas (structured block via webhook body).\n// Fall back to the Haiku parse ONLY if no structured data was sent (transition safety).\nconst body = $('Webhook').first().json.body || {};\nconst op = $('Op Router').first().json.op;\nlet prov = op === 'set'\n  ? (Array.isArray(body.personas) ? body.personas : null)\n  : (body.persona ? [body.persona] : (Array.isArray(body.personas) ? body.personas : null));\nif (prov && prov.length) return [{ json: { output: prov, source: 'provided' } }];\nlet agentOut = null;\ntry { agentOut = $('Persona Parser Agent').first().json.output; } catch (e) {}\nreturn [{ json: { output: agentOut || [], source: 'haiku-fallback' } }];"
        }
      },
