      {
        "id": "parser-agent",
        "name": "Persona Parser Agent",
        "type": "@n8n/n8n-nodes-langchain.agent",
        "typeVersion": 2.2,
        "position": [
          1200,
          250
        ],
        "parameters": {
          "promptType": "define",
          "text": "={{ $('Op Router').item.json.content }}",
          "hasOutputParser": false,
          "options": {
            "systemMessage": "You parse coordinator-output text into strict JSON.\n\nOutput ONLY a JSON array of persona objects with fields:\n  persona_id  — lowercase first name only (e.g. 'lena', 'mira')\n  name        — full name (e.g. 'Lena Hofer')\n  type        — role/profession one-liner\n  core_perspective — 1-2 sentence summary\n  profile     — full descriptive profile (multi-line OK)\n\nRules:\n- ONLY personas explicitly described in the input text.\n- Do NOT invent personas. If only 1 is described, return array with 1 item.\n- persona_id MUST be lowercase ASCII first name (no umlauts, no spaces).\n  If the first name contains umlauts (Mü -> mu, ö -> oe), normalize.\n- NO commentary, NO code fences, NO explanation. Just the JSON array."
          }
        }
      },
      {
        "id": "build-records",
        "name": "Build Records",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1440,
          250
        ],
        "parameters": {
          "jsCode": "const trig = $('Op Router').first().json;\nconst sessionId = trig.sessionId;\nconst op = trig.op;\nconst personaIdHint = trig.personaId;\n\n// Existing panel. Check Committed returns ONE row {rows:[{persona_id,slack_slot,status}], cnt}.\n// Slot-aware assignment = bulletproof: deltas never collide with already-occupied slots.\nconst cc = $('Check Committed').first().json || {};\nconst committedCnt = Number(cc.cnt) || 0;\nlet existingRaw = cc.rows;\nif (typeof existingRaw === 'string') { try { existingRaw = JSON.parse(existingRaw); } catch (e) { existingRaw = []; } }\nconst existing = Array.isArray(existingRaw) ? existingRaw : [];\nconst slotByPid = {};\nconst occupied = new Set();\nfor (const r of existing) {\n  const s = Number(r && r.slack_slot);\n  if (r && r.persona_id) slotByPid[r.persona_id] = s;\n  if (s) occupied.add(s);\n}\nfunction nextFreeSlot() {\n  for (let s = 1; s <= 8; s++) { if (!occupied.has(s)) { occupied.add(s); return s; } }\n  return 8;\n}\n\nconst raw = $('Resolve Personas').first().json.output || $('Resolve Personas').first().json.text || '[]';\nlet personas;\ntry {\n  const cleaned = typeof raw === 'string' ? raw.replace(/^```json\\s*|\\s*```$/g, '').trim() : raw;\n  personas = typeof cleaned === 'string' ? JSON.parse(cleaned) : cleaned;\n} catch (e) {\n  console.warn('ProposePersonas: Haiku output not valid JSON, aborting safely (no delete):', e.message);\n  return [];\n}\nif (!Array.isArray(personas)) { console.warn('ProposePersonas: parser output not an array, aborting safely'); return []; }\nif (personas.length === 0) return [];\n\nfunction normalizeId(s) {\n  return String(s || '').toLowerCase()\n    .replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss')\n    .replace(/[^a-z0-9_-]/g, '');\n}\n\n// op=update targets exactly ONE existing persona. Keep its persona_id so the upsert REPLACES\n// the row in place (same slot, no duplicate) even when the LLM renames it (Lara -> Napoleon).\nif (op === 'update' && personaIdHint) {\n  personas = personas.slice(0, 1);\n  personas[0].persona_id = personaIdHint;\n}\n\nreturn personas.slice(0, 8).map((p, i) => {\n  const pid = normalizeId(p.persona_id || p.name || '').slice(0, 30) || ('p' + (i + 1));\n  let slot;\n  if (op === 'set') {\n    slot = i + 1;\n  } else if (slotByPid[pid] != null) {\n    slot = slotByPid[pid];\n  } else {\n    slot = nextFreeSlot();\n  }\n  return { json: {\n    session_id: sessionId,\n    persona_id: pid,\n    name: String(p.name || '').slice(0, 100),\n    type: String(p.type || '').slice(0, 200),\n    core_perspective: String(p.core_perspective || '').slice(0, 400),\n    profile: String(p.profile || '').slice(0, 3000),\n    slack_slot: slot,\n    rigidity: 5,\n    status: (committedCnt > 0) ? 'committed' : 'proposed'\n  }};\n});"
        }
      },
