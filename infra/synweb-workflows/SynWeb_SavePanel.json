      },
      {
        "id": "collect-1",
        "name": "Collect Rows",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          880,
          -120
        ],
        "parameters": {
          "jsCode": "const items = $input.all();\nconst real = items.filter(i => i.json && i.json.persona_id && i.json.session_id);\nconst throwIfEmpty = false;\nif (real.length === 0 && throwIfEmpty) {\n  const sid = $('Execute Workflow Trigger').first().json.session_id;\n  throw new Error('SavePanel-Guardrail: 0 proposed personas in DB fuer session ' + sid +\n    ' (auch nach Retry). ProposePersonas ist gecrasht oder Marker fehlte. Coordinator muss Panel NEU senden mit <!-- syn:phase=panel_proposed -->.');\n}\nreturn real;\n"
        }
      },
