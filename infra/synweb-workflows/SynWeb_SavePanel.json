        "alwaysOutputData": true,
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH promoted AS (\n  UPDATE \"data_table_user_oAfVlk69fSh57ABR\" SET status='committed'\n  WHERE session_id=$1 AND status='proposed' RETURNING persona_id\n)\nSELECT persona_id, name, slack_slot, type, core_perspective\nFROM \"data_table_user_oAfVlk69fSh57ABR\"\nWHERE session_id=$1 AND status='committed';",
          "options": {
            "queryReplacement": "={{ $('Execute Workflow Trigger').first().json.session_id }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "3bFmPfSLWhmF9NRR",
            "name": "Postgres account"
          }
        }
