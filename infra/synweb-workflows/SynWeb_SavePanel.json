      {
        "id": "has-personas",
        "name": "Has Personas?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.3,
        "position": [
          660,
          0
        ],
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "loose",
              "version": 2
            },
            "conditions": [
              {
