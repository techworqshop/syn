      {
        "id": "savepanel-retry-guard",
        "name": "Retry Guard",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1100,
          160
        ],
        "parameters": {
          "jsCode": "const sid = $('Execute Workflow Trigger').first().json.session_id;\n// Promote 1 liefert ALLE committed Personas (gerade promoted ODER schon committed)\n// -> idempotent, sofortiger Erfolg bei Re-Call. Hierher nur wenn WEDER committed\n// NOCH proposed existiert = echte Race (Commit vor Proposal). Kurz pollen (~30s),\n// da SavePanel SYNCHRON in der Agent-Kette laeuft (laengeres Warten blockt den\n// Coordinator / die User-Antwort).\nif ($runIndex >= 5) {\n  throw new Error('SavePanel-Guardrail: nach ~30s weder committed noch proposed personas fuer session ' + sid +\n    '. Proposal kam nie an (Marker fehlte / ProposePersonas leer). Coordinator muss das Panel neu senden mit <!-- syn:phase=panel_proposed -->.');\n}\nreturn [{ json: { tick: $runIndex, session_id: sid } }];"
        }
      },
      {
        "id": "23379381-6ed6-4c55-9394-9d97c569c862",
        "name": "Wait For Pre-Save",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          880,
          160
        ],
        "parameters": {
          "jsCode": "// In-process delay (NOT an n8n Wait node): keeps SavePanel one synchronous pass,\n// so the agent tool-call always receives the FINAL committed list instead of an\n// early empty resume (that early resume was the false 'Schluckauf' trigger).\nawait new Promise(r => setTimeout(r, 4000));\nreturn $input.all();"
        }
      }
