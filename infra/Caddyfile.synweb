(security_headers) {
	header {
		# HTTPS-only — Browser cached for 1 year, includes subdomains, preload-ready
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Prevent clickjacking — page cannot be loaded in any iframe
		X-Frame-Options "DENY"
		# Block MIME-sniffing
		X-Content-Type-Options "nosniff"
		# Don't leak full URL on cross-origin navigation
		Referrer-Policy "strict-origin-when-cross-origin"
		# Disable APIs we don't use (camera/mic/geolocation/FLoC)
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(self)"
		# CSP — baseline; tightened with nonces would be ideal but Next.js inlines runtime scripts.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.chargebee.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://n8n.worqshop.io https://*.chargebee.com https://api.stripe.com; frame-src https://*.chargebee.com https://js.chargebee.com https://js.stripe.com https://hooks.stripe.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none';"
		# Hide Caddy version
		-Server
		# Pin to HTTPS only
		Cross-Origin-Opener-Policy "same-origin"
	}
}

n8n.worqshop.io {
    encode zstd gzip
    reverse_proxy 127.0.0.1:5678 {
        flush_interval -1
    }
}

mcp.n8n.worqshop.io {
    @messages path /messages*
    handle @messages {
        reverse_proxy 127.0.0.1:3001 {
            header_up Authorization "Bearer ba7d777659b64424bc05f0f694ef50f4eee7d105b19f2ee2592199c44f8ef21d"
            header_up -X-Forwarded-For
            header_up -X-Forwarded-Proto
            header_up -X-Forwarded-Host
            flush_interval -1
        }
    }

    @unauthorized {
        not query token=efrZ3eHATjRETqdfOwLYsyY9yReKXUEAC7FQf5pr
    }
    handle @unauthorized {
        respond 403
    }

    handle {
        reverse_proxy 127.0.0.1:3001 {
            header_up Authorization "Bearer ba7d777659b64424bc05f0f694ef50f4eee7d105b19f2ee2592199c44f8ef21d"
            header_up -X-Forwarded-For
            header_up -X-Forwarded-Proto
            header_up -X-Forwarded-Host
            flush_interval -1
        }
    }
}
# SynWeb reverse proxy block.
# Append to /etc/caddy/Caddyfile, then: systemctl reload caddy
# Remove: delete this block and reload.

syn.worqshop.io {
    import security_headers
    encode zstd gzip

    # Long-lived SSE connections for realtime persona responses
    @sse path_regexp ^/api/(sessions/[^/]+/stream|stream)
    handle @sse {
        reverse_proxy 127.0.0.1:3100 {
            flush_interval -1
            transport http {
                read_timeout 0
            }
        }
    }

    handle {
        reverse_proxy 127.0.0.1:3100
    }
}

# Production-Domain: asksyn.com (+ www) + App-Subdomain
# Routet zum PROD-Stack (synweb-prod-app) auf Port 3200 - separater Stack,
# eigene DB, eigene Accounts. Dev bleibt auf 3100 (syn.worqshop.io).
asksyn.com, www.asksyn.com, app.asksyn.com {
    import security_headers
    encode zstd gzip

    @app_root {
        host app.asksyn.com
        path /
    }
    redir @app_root /app/dashboard

    @apex_app {
        host asksyn.com www.asksyn.com
        path /app /app/* /login
    }
    redir @apex_app https://app.asksyn.com{uri}

    @sse path_regexp ^/api/(sessions/[^/]+/stream|stream)
    handle @sse {
        reverse_proxy 127.0.0.1:3200 {
            flush_interval -1
            transport http {
                read_timeout 0
            }
        }
    }

    handle {
        reverse_proxy 127.0.0.1:3200
    }
}

# Sekundaerdomains: 301-Permanent-Redirect auf asksyn.com,
# Pfad + Query bleiben erhalten.
asksyn.de, www.asksyn.de, asksyn.org, www.asksyn.org, asksyn.store, www.asksyn.store {
    import security_headers
    redir https://asksyn.com{uri} 301
}

